# Copy this file to .streamlit/secrets.toml for local runs.
# On Streamlit Community Cloud, paste the same content into
# your app's Settings -> Secrets panel instead of committing a real file.

# =========================================================================
# Authentication — pick ONE of the two options below (or neither, for
# unauthenticated local testing — the app will show a warning banner).
# =========================================================================

# --- Option A: shared password, no IT setup needed ---
# app_password = "choose-a-password"
#
# Optionally also require a work email at login, restricted to a domain —
# NOT cryptographically verified (anyone who knows the password can type
# any matching email), but it does gate the door by domain and gives the
# Approvals tab an identity to check approvers against, without needing
# Azure AD. Real verification is Option B below, once you have it.
# email_domains = ["accenture.com"]

# --- Option B: real sign-in via Microsoft Entra ID (or any OIDC provider).
# Needs an Azure AD "app registration for sign-in" from your IT/identity
# team — see README for the exact ask. Once configured, this also lets the
# Approvals tab restrict Approve/Reject to the matching approver's email.
# [auth]
# redirect_uri = "http://localhost:8501/oauth2callback"   # update after deploying
# cookie_secret = "generate-a-long-random-string-here"
# client_id = "..."
# client_secret = "..."
# server_metadata_url = "https://login.microsoftonline.com/<tenant_id>/v2.0/.well-known/openid-configuration"
#
# Restricting sign-in to only your org: the main enforcement should be a
# single-tenant app registration (ask IT for "Accounts in this
# organizational directory only"), which rejects outside accounts before
# this app ever sees them. These two are an optional backstop in the code:
# allowed_tenant_id = "..."                  # your Entra ID tenant GUID
# allowed_email_domains = ["accenture.com"]

# =========================================================================
# Search: Groq is used automatically if GROQ_API_KEY is set.
# Anthropic works too as a fallback if you'd rather use that.
# =========================================================================
GROQ_API_KEY = "gsk_..."
# ANTHROPIC_API_KEY = "sk-ant-..."
# LLM_PROVIDER = "groq"          # optional override: "groq" or "anthropic"
# GROQ_MODEL = "openai/gpt-oss-120b"   # optional override

# =========================================================================
# Storage: leave this whole [sharepoint] section out to use local
# SQLite instead (zero setup, good for a first run).
# =========================================================================
# [sharepoint]
# tenant_id = "..."
# client_id = "..."
# client_secret = "..."
# site_url = "https://yourtenant.sharepoint.com/sites/YourSite"
# doc_library = "Documents"
# docs_list = "IncidentDocuments"
# approvals_list = "IncidentApprovals"

# =========================================================================
# Optional: real approval emails
# =========================================================================
[smtp]
host = "smtp.gmail.com"
port = 587
username = "you@example.com"
password = "an app password, not your account password"
from_addr = "you@example.com"
